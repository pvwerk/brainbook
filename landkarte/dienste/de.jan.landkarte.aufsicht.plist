<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>de.jan.landkarte.aufsicht</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>LANDKARTE/bin/landkarte aufsicht</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key> <integer>1</integer>
    <key>Hour</key>    <integer>7</integer>
    <key>Minute</key>  <integer>30</integer>
  </dict>
  <!-- Ein launchd-Dienst hat einen beschnittenen PATH, und /bin/sh -lc
       liest unter zsh weder ~/.zprofile noch ~/.zshrc. Ohne das hier findet
       der Dienst `claude` nicht und der Testleser laeuft jede Nacht leer. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>HEIM/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>    <string>HEIM/.landkarte/dienst-aufsicht.log</string>
  <key>StandardErrorPath</key>  <string>HEIM/.landkarte/dienst-aufsicht.log</string>
  <key>RunAtLoad</key>          <false/>
  <key>Nice</key>               <integer>5</integer>
</dict>
</plist>
