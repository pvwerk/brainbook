#!/usr/bin/env python3
"""Hook-Einstieg der Tresorwache. Schlank gehalten, weil er bei jedem
Prompt laeuft: nur die zwei Module, die wirklich gebraucht werden.

Liest den Hook-Datensatz von stdin, legt gefundene Geheimnisse in den Tresor,
ersetzt sie im Sitzungsprotokoll und meldet das Ergebnis als Zusatzhinweis.
Endet immer mit 0 - ein Waechter, der die Sitzung blockiert, waere schlimmer
als das Problem, das er loest.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

WURZEL = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(WURZEL))


def main() -> int:
    try:
        daten = json.load(sys.stdin)
    except Exception:
        return 0

    text = str(daten.get("prompt") or "")
    if not text.strip():
        return 0

    try:
        from lk import tresorwache
    except Exception:
        return 0

    try:
        paare = tresorwache.aufnehmen(text, quelle="Chat")
    except Exception:
        return 0
    if not paare:
        return 0

    ersetzt = 0
    pfad = daten.get("transcript_path")
    if pfad:
        try:
            ergebnis = tresorwache.verlauf_saeubern(Path(pfad), paare)
            ersetzt = ergebnis.get("ersetzt", 0)
        except Exception:
            ersetzt = 0

    namen = ", ".join(n for n, _ in paare)
    hinweis = (
        f"TRESORWACHE: {len(paare)} Zugangsdatum/-daten erkannt und verschlüsselt "
        f"abgelegt unter: {namen}. "
        f"Im Sitzungsprotokoll wurden {ersetzt} Vorkommen durch [Tresor: <name>] "
        f"ersetzt. "
        "Schreibe das Geheimnis NICHT noch einmal aus – weder in eine Antwort "
        "noch in eine Datei noch in einen Befehl. Hole es bei Bedarf mit "
        "`landkarte tresor holen <name>` und gib es nur über stdin oder eine "
        "Umgebungsvariable weiter."
    )
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": hinweis,
        },
        "systemMessage": f"🔐 Tresor: {namen} aufgenommen, {ersetzt}× im Verlauf ersetzt.",
    }))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
